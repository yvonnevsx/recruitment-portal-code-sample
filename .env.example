# Client side environment variables.
VITE_DEV_MODE=true
VITE_MOCK_MODE=true

# Base URL van de API (zonder protocol), bijv. localhost:3000.
# Wordt gebruikt als proxy-target voor /api in de Vite dev server.
VITE_API_URL=localhost:3000

# Microsoft Entra ID (Azure AD) - haal op uit Azure Portal > App registrations
VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-here
