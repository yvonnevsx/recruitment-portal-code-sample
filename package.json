{
  "name": "recruitment-portal-code-sample",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "lint-staged",
    "lint-all": "tsc && eslint . && prettier --check . && stylelint \"src/**/*.scss\"",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
