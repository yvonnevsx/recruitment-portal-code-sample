    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "json-diff": "^1.0.6",
    "lint-staged": "^16.2.7",
    "msw": "^2.13.3",
    "prettier": "^3.7.4",
    "sass-embedded": "^1.97.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,scss,css,json}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "**/*.{scss,css}": [
      "stylelint --fix"
    ],
    "translations/*.json": [
      "node translation-diff.js"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
