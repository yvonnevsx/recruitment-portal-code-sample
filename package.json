    "@progress/kendo-react-data-tools": "13.2.0",
    "@progress/kendo-react-dateinputs": "13.2.0",
    "@progress/kendo-react-dialogs": "13.2.0",
    "@progress/kendo-react-dropdowns": "13.2.0",
    "@progress/kendo-react-excel-export": "13.2.0",
    "@progress/kendo-react-form": "13.2.0",
    "@progress/kendo-react-grid": "13.2.0",
    "@progress/kendo-react-indicators": "13.2.0",
